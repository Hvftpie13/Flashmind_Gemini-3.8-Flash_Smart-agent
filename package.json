{
  "name": "flashmind",
  "version": "1.0.0",
  "description": "Persistent memory (Engram), coding skills, and no-hallucination rules for Gemini 3.8 Flash — works in Gemini CLI, Antigravity, Cursor, VS Code, Claude Code and any MCP client.",
  "main": "server/index.js",
  "type": "commonjs",
  "bin": {
    "flashmind": "server/index.js"
  },
  "files": [
    "server/",
    "skills/",
    "commands/",
    "configs/",
    "scripts/",
    "GEMINI.md",
    "AGENTS.md",
    "gemini-extension.json"
  ],
  "scripts": {
    "start": "node server/index.js",
    "test": "node test/smoke.js && node test/config.js",
    "build:configs": "node scripts/build-configs.js"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hvftpie13/flashmind.git"
  },
  "keywords": [
    "mcp",
    "gemini",
    "gemini-cli",
    "gemini-flash",
    "antigravity",
    "engram",
    "memory",
    "agent-skills",
    "anti-hallucination",
    "ai-agents"
  ],
  "license": "MIT"
}
